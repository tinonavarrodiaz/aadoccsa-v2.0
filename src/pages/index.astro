---
import Slider from '@/components/Slider';
import Layout from '../layouts/Layout.astro';
import Cards from '@/components/home/Cards.astro';
import { CardsHome } from '@/data/cards';
import Videos from '@/components/home/Videos.astro';
---

<Layout page="index">
  <Slider client:load/>
	<h1 class="title-page"><span>Ponemos</span> a su disposición el <span>más alto</span> nivel de <span>servicio</span></h1>
  <article class="card-grid">
    {
      CardsHome.map((item:any)=>(
        <Cards title={item.title} content={item.description} link={item.link}/>
      ))
    }
  </article>
  <h2 class="title-page">Sabemos lo que usted necesita<br/><span>Porque somos líderes</span></h2>
  <Videos/>
</Layout>
