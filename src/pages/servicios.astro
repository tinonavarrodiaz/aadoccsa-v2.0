---
import LayoutPage from "@/layouts/LayoutPage.astro";
---

<LayoutPage banner="/img/life-new.jpg" page="Servicios" back="false">
  <h2>Nuestros Servicios</h2>
  <div class="servicios__grid">
    <div class="servicios__imgs">
      <img src="/img/productos/titanium8.jpg" alt="titanium8">
      <img src="/img/productos/titanium7.jpg" alt="titanium7">
      <img src="/img/paquetes/paquetes05.jpg" alt="paquetes 1">
      <img src="/img/paquetes/paquetes04.jpg" alt="paquetes 2">
    </div>
    <ul class="servicios__list">
      <li>Venta</li>
      <li>Instalación</li>
      <li>Reparación</li>
      <li>Mantenimiento</li>
      <li>Proyectos</li>
      <li>Licitaciones</li>
    </ul>
  </div>

</LayoutPage>
